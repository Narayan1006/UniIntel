# TrustLens AI — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ---- Groq AI ----
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_TEXT_MODEL_NAME=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL_NAME=llama-3.1-8b-instant
GROQ_VISION_MODEL_NAME=llama-3.2-11b-vision-preview

# ---- Database ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trustlens
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ---- File Storage ----
STORAGE_BASE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ---- Web Validation ----
WEB_VALIDATION_TIMEOUT_SECONDS=5

# ---- Embedding (HuggingFace Inference API) ----
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here
EMBEDDING_API_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# ---- RAG ----
RAG_MIN_SIMILARITY_SCORE=0.70
RAG_DEFAULT_TOP_K=5
